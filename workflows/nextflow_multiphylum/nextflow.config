/*
 * Nextflow configuration for the multiphylum phylaCOI workflow.
 *
 * Run from the repository root:
 *   nextflow run workflows/nextflow_multiphylum/main.nf -c workflows/nextflow_multiphylum/nextflow.config
 */

params {
    repo_dir = null

    raw_fasta = 'data/raw/eKOI_metabarcoding.fasta'
    reference_db = 'data/raw/eKOI_database.fasta'
    sample_metadata = 'data/raw/KOI_metadata.csv'
    ocean_metadata = 'data/raw/ocean_metadata.csv'
    output_root = 'data'

    vsearch_identity = 0.84
    otu_identity = 0.97
    run_mafft = 1
    min_otus = 10
    max_parallel_phyla = 2
    max_otu_seqs = 500
    cluster_radius_km = 5
    write_maps = true
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-ueo', 'pipefail']
}

profiles {
    local {
        process.executor = 'local'
    }
}

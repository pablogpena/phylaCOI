/*
 * Nextflow configuration for the phase 1 wrapper workflow.
 *
 * Run from the repository root:
 *   nextflow run workflows/nextflow/main.nf -c workflows/nextflow/nextflow.config
 */

params {
    repo_dir = null

    raw_fasta = 'data/raw/eKOI_metabarcoding.fasta'
    reference_db = 'data/raw/eKOI_database.fasta'
    sample_metadata = 'data/raw/KOI_metadata.csv'
    ocean_metadata = 'data/raw/ocean_metadata.csv'
    output_root = 'data'

    vsearch_identity = 0.84
    otu_identity = 0.97
    run_mafft = 1
    min_otus = 10
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-ueo', 'pipefail']
}

profiles {
    standard {
        process.executor = 'local'
    }

    dryrun {
        process.executor = 'local'
        process.beforeScript = 'echo "[dryrun] Running in $(pwd)"'
    }
}
